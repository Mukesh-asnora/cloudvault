# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# ---- PostgreSQL ----
POSTGRES_USER=cloudvault
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_PORT=5432

# Separate logical databases per service (created automatically by db-init script)
AUTH_DB_NAME=auth_db
METADATA_DB_NAME=metadata_db

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO (S3-compatible local storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=cloudvault-files

# ---- JWT ----
# Generate a real secret with: openssl rand -base64 64
JWT_SECRET=replace_this_with_a_generated_64_byte_base64_secret
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ---- Service ports (host side) ----
AUTH_SERVICE_PORT=8081
FILE_SERVICE_PORT=8082
METADATA_SERVICE_PORT=8083
API_GATEWAY_PORT=8080
FRONTEND_PORT=3000